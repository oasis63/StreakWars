# backend/.env.example
PORT=3001
AUTH_SECRET=change-me-in-production

# Supabase PostgreSQL — on Render use the Session pooler URI from
# Project Settings → Database → Connect (host like aws-0-….pooler.supabase.com).
# Direct db.….supabase.co:5432 connections exhaust the free-tier limit on each deploy.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:streak-wars-password@db.fffyojfxtjatmutusgvv.supabase.co:5432/postgres?sslmode=require
PG_POOL_MAX=4
